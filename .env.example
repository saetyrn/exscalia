# Copy to .env next to docker-compose.yml and fill in.

# Username and password for the web UI. Leave the password empty to disable
# auth (NOT recommended on a public server).
OMNIA_AUTH_USERNAME=owner
OMNIA_AUTH_PASSWORD=

# Random secret for signing session cookies. Generate with:
#   openssl rand -hex 32
OMNIA_SESSION_SECRET=

# IANA timezone used for Daily, calendar milestones, and OMNIA day threads.
OMNIA_TIMEZONE=America/New_York

# AI keys — enable OMNIA, the AI overseer. Leave empty to run AI-free, or set
# them from the in-app Settings page instead (UI values override these).
# Provider: "anthropic" (default), "openai", or "google" — switchable in Settings.
OMNIA_AI_PROVIDER=anthropic
OMNIA_ANTHROPIC_API_KEY=
OMNIA_OPENAI_API_KEY=
OMNIA_GOOGLE_API_KEY=

# Your domain for automatic HTTPS via Caddy/Let's Encrypt.
# Leave unset to serve on https://localhost with a self-signed certificate.
DOMAIN=

# Optional extra domain (e.g. the bare apex) that permanently redirects to
# DOMAIN. Needs its own DNS record pointing at this server.
REDIRECT_DOMAIN=

# Optional: swap the local embedding model (fastembed model name).
# OMNIA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Off-site backup: push the vault to a private git remote on an interval.
# Create an empty private repo + a fine-grained access token (contents:
# read/write on that one repo), then:
# OMNIA_BACKUP_REMOTE=https://x-access-token:YOUR_TOKEN@github.com/you/vault-backup.git
# OMNIA_BACKUP_INTERVAL=3600
OMNIA_BACKUP_REMOTE=
