# Configuration for omnianote-backup.sh. Copy to /etc/omnianote-backup.env,
# chmod 600, and replace every placeholder. docker reads this file with
# --env-file, which takes values literally: no quotes, no `export`.

# Repository, as an S3 URL ending in a folder inside the bucket.
# Backblaze B2 (the endpoint is on the bucket's page):
RESTIC_REPOSITORY=s3:https://s3.YOUR-REGION.backblazeb2.com/YOUR-BUCKET/exscalia
# Cloudflare R2:
# RESTIC_REPOSITORY=s3:https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com/YOUR-BUCKET/exscalia

# Bucket credentials: a B2 application key (keyID / applicationKey) or an R2
# API token's S3 access key pair. Scope the key to this one bucket.
AWS_ACCESS_KEY_ID=YOUR-KEY-ID
AWS_SECRET_ACCESS_KEY=YOUR-SECRET-KEY
# R2, if restic reports a region error:
# AWS_DEFAULT_REGION=auto

# Encryption password for the repository. Without it no snapshot can be read,
# so keep a copy off this server (a password manager). Either a file, which
# the script mounts into the restic container:
RESTIC_PASSWORD_FILE=/etc/omnianote-restic.pass
# or the password itself:
# RESTIC_PASSWORD=YOUR-LONG-RANDOM-PASSWORD
